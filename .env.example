# Copy this file to .env and fill in your own values. The real .env file holds
# secrets and must never be committed or shared.

# Application display name (required: the app will not start without it).
APP_NAME=your_app_name

# Anthropic API key used to access Claude. Use your organization's API key
# here, not your personal Claude Pro login.
ANTHROPIC_API_KEY=your_real_key_here

# Claude model identifier used for requests.
CLAUDE_MODEL=claude-sonnet-4-6

# Maximum time, in seconds, to wait for a Claude request.
CLAUDE_TIMEOUT_SECONDS=30

# Number of times to retry a failed Claude request.
CLAUDE_MAX_RETRIES=2

# How much the application logs: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# In-memory cache for FAQ searches, so repeated questions skip MongoDB.
# Set FAQ_CACHE_ENABLED to false to turn the cache off.
FAQ_CACHE_ENABLED=true
# How long, in seconds, a cached search result stays valid (up to 3600).
FAQ_CACHE_TTL_SECONDS=60
# Maximum number of searches kept in the cache (1 to 1000).
FAQ_CACHE_MAX_ENTRIES=100

# MongoDB connection string. Replace the YOUR_* placeholders with your own
# values and never commit the real one: it contains a password.
MONGODB_URI=mongodb://YOUR_DB_USER:YOUR_PASSWORD@localhost:27017/YOUR_DB?authSource=YOUR_DB
# Name of the database the application reads from and writes to.
MONGODB_DATABASE=YOUR_DB
